# Local PostgreSQL (the included Docker setup exposes it on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/app_db

NODE_ENV=development
PYTHON_PATH=python
USER_AGENT=NewsPulseBot/1.0
ARTICLE_REQUEST_TIMEOUT=6
MIN_SHARED_KEYWORDS=3
SIMILARITY_THRESHOLD=0.22
USE_TFIDF=true
